    "version": "0.2.0",
    "configurations": [

        {
            "name": "Flutter Web (Chrome)",
            "type": "dart",
            "request": "launch",
            "program": "${workspaceFolder}/lib/main.dart",
            "deviceId": "chrome",
            "args": ["--web-port=8000",
                "--dart-define=API_URL=http://10.0.0.1:8080"
            ]
        }
    ]
}